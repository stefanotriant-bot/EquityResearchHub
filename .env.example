# Copy this file to .env on the server and fill in real values.
# Never commit .env to git.

# Flask
FLASK_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=https://yourdomain.com

# Owner email gets free permanent Patron access
OWNER_EMAIL=you@yourdomain.com

# Stripe (from dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe price IDs (from your Products dashboard, must match these tiers)
STRIPE_PRICE_APPRENTICE_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_APPRENTICE_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PATRON_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PATRON_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_LIFETIME=price_xxxxxxxxxxxx

# Anthropic (powers AI company briefs, the flagship Pro feature)
# Get one at console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
